    rule merge_partitions:
        input:
            bed=rules.normalize_blocks.output.bed,
            target_fai=rules.faidx_block_reference.output
        output:
            bed=str(MERGED_BED),
            groups=str(MERGED_GROUPS)
        params:
            helper=HELPER
        shell:
            """
            {PYTHON:q} {params.helper:q} grouped-merge \
              --bed {input.bed:q} \
              --target-fai {input.target_fai:q} \
              --output {output.bed:q} \
              --groups {output.groups:q}
            """
else:
    rule merge_partitions:
        input:
            reference=rules.build_sequence_catalog.output,
            target=rules.extract_block_reference.output.fasta,
            filtered=rules.filter_reference_block_mapping.output
        output:
            bed=str(MERGED_BED),
            groups=str(MERGED_GROUPS)
        threads:
            TOTAL_THREADS
        params:
            executable=KMERPARTITIONMERGER
        shell:
            """
            {params.executable:q} \
              -f {input.reference:q} \
              -T {input.target:q} \
              -b {input.filtered:q} \
              -o {output.bed:q} \
              -m 10 \
              -t {threads} \
              --only-kmer
            test -s {output.bed:q}
            test -s {output.groups:q}
            """


checkpoint build_localblocks:
    input:
        bed=str(FILTERED_BED),
        merged=rules.merge_partitions.output.bed,
        groups=rules.merge_partitions.output.groups,
        query=rules.validate_and_order_inputs.output.query,
        target=rules.extract_block_reference.output.fasta,
        target_fai=rules.faidx_block_reference.output
    output:
        target_list=str(TEMPLATE_PARTITION_TARGETS)
    params:
        script=str(SCRIPT_DIR / "build_localblocks_from_filtered_bed.py"),
        helper=HELPER,
        localblocks=str(LOCALBLOCKS),
        unmask=int(config.get("block_unmask", 1000)),
        target_origins=("--target-origins-only" if BED_GROUPED else "")
    shell:
        """
        {PYTHON:q} {params.script:q} \
          -b {input.bed:q} \
          --merged-bed {input.merged:q} \
          -q {input.query:q} \
          -t {input.target:q} \
          -o {params.localblocks:q} \
          --unmask {params.unmask} {params.target_origins}
        {PYTHON:q} {params.helper:q} list-partitions \
          --localblocks {params.localblocks:q} \
          --output {output.target_list:q}
        """


rule kmersearcher_dummy:
    output:
        fasta=str(DUMMY_FASTA),
        list=str(DUMMY_LIST)
    params:
        helper=HELPER
    shell:
        """
        {PYTHON:q} {params.helper:q} write-dummy \
          --fasta {output.fasta:q} \
          --list {output.list:q}
        """


rule index_template_partition_targets:
    input:
        source_targets=str(TEMPLATE_PARTITION_TARGETS),
        dummy=rules.kmersearcher_dummy.output.list
    output:
        index=str(TEMPLATE_PARTITION_INDEX)
    threads:
        TOTAL_THREADS
    params:
        executable=KMER_SEARCHER,
        outdir=str(TEMPLATE_PARTITION_TARGETS.parent)
    shell:
        """
        mkdir -p {params.outdir:q}
        # KmerSearcher loads TARGET_LIST.bin whenever it already exists.
        # Remove this rule's exact output so a stale or zero-byte file cannot
        # be mistaken for a serialized k-mer hash during a requested rebuild.
        rm -f {output.index:q}
        {params.executable:q} \
          -T {input.source_targets:q} \
          -I {input.dummy:q} \
          -o {params.outdir:q}/ \
          -c 1000 \
          -w 2000 \
          -n {threads}
        test -s {output.index:q}
        """


rule search_assembly_blocks:
    input:
        targets=str(TEMPLATE_PARTITION_TARGETS),
        index=rules.index_template_partition_targets.output.index,
        fasta=sample_fasta,
        query=rules.validate_and_order_inputs.output.query
    output:
        str(KMERMAPS / "{sample}_hotspot.txt")
    threads:
        1 if SLURM_ENABLED else TOTAL_THREADS
    resources:
        slurm_jobs=1 if SLURM_ENABLED else 0
    params:
        executable=KMER_SEARCHER,
        outdir=str(KMERMAPS),
        workers=KMERSEARCH_SLURM_CPUS if SLURM_ENABLED else TOTAL_THREADS,
        slurm=lambda wildcards: slurm_prefix(
            f"kmersearch-{wildcards.sample}",
            KMERSEARCH_SLURM_CPUS,
            KMERSEARCH_SLURM_MEMORY,
        )
    shell:
        """
        mkdir -p {params.outdir:q}
        {params.slurm} {params.executable:q} \
          -T {input.targets:q} \
          -i {input.fasta:q} \
          -p {wildcards.sample:q} \
          -o {params.outdir:q}/ \
          -c 1000 \
          -w 2000 \
          -N {params.workers}
        # A sample with no qualifying partition hits has a valid empty map.
        test -f {output:q}
        """


checkpoint finalize_hotspot_fastas:
    input:
        targets=str(TEMPLATE_PARTITION_TARGETS),
        hotspots=expand(str(KMERMAPS / "{sample}_hotspot.txt"), sample=SAMPLES)
    output:
        active=str(ACTIVE_TARGETS),
        ready=str(HOTSPOT_READY)
    threads:
        TOTAL_THREADS
    params:
        generator=HOTSPOT_HEADER_GENERATOR,
        query=str(NORMALIZED_QUERY),
        localblocks=str(LOCALBLOCKS),
        kmers=str(KMERMAPS),
        anchor=int(config.get("hotspot_anchor", 30000))
    shell:
        """
        {PYTHON:q} {params.generator:q} \
          --hotspot-dir {params.kmers:q} \
          -q {params.query:q} \
          -T {input.targets:q} \
          -o {params.localblocks:q} \
          --active-list {output.active:q} \
          -j {threads} \
          --hotspot-anchor {params.anchor} \
          --resume
        mkdir -p $(dirname {output.ready:q})
        touch {output.ready:q}
        """


checkpoint make_partition_batches:
    input:
        active=lambda wildcards: checkpoints.finalize_hotspot_fastas.get().output.active,
        ready=lambda wildcards: checkpoints.finalize_hotspot_fastas.get().output.ready
    output:
        batches=directory(str(BATCH_DIR)),
        ids=str(BATCH_IDS)
    params:
        helper=HELPER,
        batch_count=PARTITION_BATCHES
    shell:
        """
        {PYTHON:q} {params.helper:q} make-batches \
          --input {input.active:q} \
          --output {output.batches:q} \
          --ids {output.ids:q} \
          --count {params.batch_count}
        """


rule minset_partition_batch:
    input:
        block_policy=BLOCK_POLICY_INPUTS,
        manifest=batch_manifest,
        ready=lambda wildcards: checkpoints.finalize_hotspot_fastas.get().output.ready,
        query=rules.validate_and_order_inputs.output.query,
        reference=([] if TEMPLATE_DEFINED else [str(FIXED_FASTA)]),
        reference_fai=([] if TEMPLATE_DEFINED else [str(FIXED_FASTA_FAI)])
    output:
        str(GRAPH / "batch_status" / PARTITION_RUN_PROTOCOL / "{batch}.done")
    threads:
        1 if SLURM_ENABLED else TOTAL_THREADS
    resources:
        slurm_jobs=1 if SLURM_ENABLED else 0
    params:
        helper=HELPER,
        script=str(SCRIPT_DIR / "minsetref_light.py"),
        graph_script=str(SCRIPT_DIR / "minsetgraphmake.py"),
        coordinate_script=str(SCRIPT_DIR / "analyze_partition_coordinates.py"),
        refinement_script=str(SCRIPT_DIR / "map_all_novels_to_local_templates.py"),
        apply_script=str(SCRIPT_DIR / "apply_unified_novel_refinement.py"),
        reference=(
            "" if TEMPLATE_DEFINED else
            "--reference-name " + shlex.quote(REFERENCE_NAME)
        ),
        outdir=str(GRAPH_OUTPUTS),
        adjusted=str(PARTITION_LOCAL_ADJUSTED),
        builder=HOTSPOT_FASTA_BUILDER,
        kmer_ref_cleaner=KMERREFCLEANER,
        payload=(
            "--alignment-payload" if ALIGNMENT_PAYLOAD
            else "--no-alignment-payload"
        ),
        alignment_mode=(
            "--fast-mode" if FAST_MODE else
            "--slow-rigorous" if SLOW_RIGOROUS else
            "--max-rigorous"
        ),
        linear="--linear" if LINEAR_OUTPUT else "",
        static="--static-block" if STATIC_BLOCK else "",
        skip="--skip-blastn" if SKIP_BLASTN else "",
        template_reference=(
            "--template-defined-reference" if TEMPLATE_DEFINED else ""
        ),
        alternative_templates=(
            "--allow-missing-bed-haplotypes" if ALTERNATIVE_FASTA else ""
        ),
        main_reference=(
            "" if TEMPLATE_DEFINED
            else "--main-reference " + shlex.quote(str(FIXED_FASTA))
        ),
        partition_jobs=MINSET_PARTITION_JOBS,
        partition_threads=MINSET_PARTITION_THREADS,
        alignment_timeout=ALIGNMENT_TIMEOUT,
        slurm=lambda wildcards: slurm_prefix(
            f"minset-{wildcards.batch}",
            MINSET_SLURM_CPUS,
            MINSET_SLURM_MEMORY,
        )
    shell:
        """
        {params.slurm} {PYTHON:q} {params.helper:q} run-batch \
          --mode integrated \
          --manifest {input.manifest:q} \
          --script {params.script:q} \
          --graph-script {params.graph_script:q} \
          --coordinate-script {params.coordinate_script:q} \
          --refinement-script {params.refinement_script:q} \
          --apply-script {params.apply_script:q} \
          --python {PYTHON:q} \
          {params.reference} \
          {params.main_reference} \
          --query-paths {input.query:q} \
          --sample-fasta-builder {params.builder:q} \
          --kmer-ref-cleaner {params.kmer_ref_cleaner:q} \
          --adjusted-dir {params.adjusted:q} \
          --output-dir {params.outdir:q} \
          --threads {params.partition_threads} \
          --jobs {params.partition_jobs} \
          --alignment-timeout {params.alignment_timeout} \
          --done {output:q} \
          {params.template_reference} \
          {params.alternative_templates} \
          {params.payload} \
          {params.alignment_mode} \
          {params.linear} \
          {params.static} \
          {params.skip}
        """


rule minset_batches_complete:
    input:
        minset_done_files
    output:
        str(MINSET_COMPLETE)
    shell:
        """
        mkdir -p $(dirname {output:q})
        touch {output:q}
        """


rule build_breakpoint_consistency:
    input:
        minsets=str(MINSET_COMPLETE),
        partitions=lambda wildcards: checkpoints.finalize_hotspot_fastas.get().output.active,
        dependencies=existing_breakpoint_dependencies
    output:
        success=str(BREAKPOINT_SUCCESS),
        manifest=str(BREAKPOINT_MANIFEST)
    threads:
        TOTAL_THREADS
    params:
        script=str(SCRIPT_DIR / "build_breakpoint_consistency.py"),
        graphfixbreaks=str(SCRIPT_DIR / "gfixbreaks.py"),
        localblocks=str(LOCALBLOCKS),
        reference=(
            "" if TEMPLATE_DEFINED else
            "--reference-haplotype " + shlex.quote(REFERENCE_NAME)
        )
    shell:
        """
        {PYTHON:q} {params.script:q} \
          --partition-list {input.partitions:q} \
          --graph-folder {params.localblocks:q} \
          --manifest {output.manifest:q} \
          --success {output.success:q} \
          --graphfixbreaks {params.graphfixbreaks:q} \
          {params.reference} \
          --jobs {threads} \
          --resume
        test -s {output.success:q}
        test -s {output.manifest:q}
        """


rule finalize_partition_targets:
    input:
        success=rules.build_breakpoint_consistency.output.success,
        manifest=rules.build_breakpoint_consistency.output.manifest
    output:
        marker=str(FINAL_TARGETS_COMPLETE),
        excluded=str(EXCLUDED_PARTITIONS),
        targets=str(PARTITION_TARGETS)
    params:
        helper=HELPER,
        localblocks=str(LOCALBLOCKS)
    shell:
        """
        {PYTHON:q} {params.helper:q} list-partitions \
          --localblocks {params.localblocks:q} \
          --output {output.targets:q} \
          --breakpoint-consistent \
          --breakpoint-manifest {input.manifest:q} \
          --excluded {output.excluded:q}
        test -s {output.targets:q}
        test -s {output.excluded:q}
        rm -f {PARTITION_INDEX:q}
        mkdir -p $(dirname {output.marker:q})
        touch {output.marker:q}
        """


rule analyze_partition_coordinates:
    input:
        minsets=rules.finalize_partition_targets.output.marker,
        ready=lambda wildcards: checkpoints.finalize_hotspot_fastas.get().output.ready,
        query=rules.validate_and_order_inputs.output.query
    output:
        str(COORDINATE_SUCCESS)
    threads:
        TOTAL_THREADS
    params:
        script=str(SCRIPT_DIR / "analyze_partition_coordinates.py"),
        localblocks=str(LOCALBLOCKS),
        output=str(COORDINATE_ANALYSIS),
        reference=REFERENCE_NAME,
        # Imported alternative templates label PARTITION.bed rows with the
        # `alternative` haplotype, which no cohort FASTA header carries; the
        # per-batch run-batch path passes the same flag for that case.
        alternative_templates=(
            "--allow-missing-bed-haplotypes" if ALTERNATIVE_FASTA else ""
        ),
        jobs=max(1, TOTAL_THREADS // 4)
    shell:
        """
        {PYTHON:q} {params.script:q} \
          -i {params.localblocks:q} \
          -o {params.output:q} \
          -j {params.jobs} \
          --sweep-jobs {params.jobs} \
          --input-anchor 50 \
          --reference-haplotypes {params.reference:q} \
          --ignore-contigs chrM \
          {params.alternative_templates} \
          --resume
        test -s {output:q}
        """


rule refine_local_templates:
    input:
        analysis=rules.analyze_partition_coordinates.output,
        query=rules.validate_and_order_inputs.output.query,
        reference=rules.combine_fixed_reference.output
    output:
        str(LOCAL_REFINEMENT_SUCCESS)
    threads:
        TOTAL_THREADS
    params:
        script=str(SCRIPT_DIR / "map_all_novels_to_local_templates.py"),
        analysis=str(COORDINATE_ANALYSIS),
        output=str(LOCAL_REFINEMENT),
        jobs=max(1, TOTAL_THREADS // 4)
    shell:
        """
        {PYTHON:q} {params.script:q} \
          -a {params.analysis:q} \
          -q {input.query:q} \
          -r {input.reference:q} \
          -o {params.output:q} \
          -j {params.jobs} \
          -c 4 \
          --minimum-flank 5000 \
          --maximum-template-gap 100 \
          --minimum-unmasked 100 \
          --resume
        test -s {output:q}
        """


rule apply_local_template_refinement:
    input:
        refinement=rules.refine_local_templates.output,
        query=rules.validate_and_order_inputs.output.query,
        reference=rules.combine_fixed_reference.output
    output:
        str(LOCAL_ADJUSTED_SUCCESS)
    threads:
        TOTAL_THREADS
    params:
        script=str(SCRIPT_DIR / "apply_unified_novel_refinement.py"),
        analysis=str(COORDINATE_ANALYSIS),
        refinement=str(LOCAL_REFINEMENT),
        output=str(LOCAL_ADJUSTED)
    shell:
        """
        {PYTHON:q} {params.script:q} \
          -a {params.analysis:q} \
          -u {params.refinement:q} \
          -q {input.query:q} \
          -r {input.reference:q} \
          -o {params.output:q} \
          --min-score 100 \
          -j {threads} \
          --resume
        test -s {output:q}
        """


rule graph_batches_complete:
    input:
        summary=str(PACKAGE_SUCCESS)
    output:
        str(GRAPH_COMPLETE)
    shell:
        """
        mkdir -p $(dirname {output:q})
        touch {output:q}
        """


if not LARGE_NOVEL_CONFIG and not FIND_NOVEL_LOCI:
    rule empty_large_novel_catalog:
        output:
            str(LARGE_NOVELS)
        shell:
            "> {output:q}"


rule refine_and_annotate_novel_sequences:
    input:
        graphs=rules.graph_batches_complete.output,
        local=rules.apply_local_template_refinement.output,
        query=rules.validate_and_order_inputs.output.query,
        reference=rules.combine_fixed_reference.output,
        large=str(LARGE_NOVELS),
        code=[str(SCRIPT_DIR / name) for name in (
            "fixed_alternatives.py", "map_global_novel.py",
            "map_small_novel_minset.py", "apply_unified_novel_refinement.py",
            "run_partition_novelty_pipeline.sh",
        )]
    output:
        success=str(ANNOTATION_SUCCESS),
        annotations=str(COHORT_ANNOTATIONS / "residual_novel_annotations.tsv")
    threads:
        TOTAL_THREADS
    params:
        driver=str(SCRIPT_DIR / "run_partition_novelty_pipeline.sh"),
        graph=str(GRAPH),
        reference_name=REFERENCE_NAME,
        skip="--skip-blastn" if SKIP_BLASTN else ""
    shell:
        """
        bash {params.driver:q} \
          --folder {params.graph:q} \
          --query {input.query:q} \
          --large-novels {input.large:q} \
          --reference {input.reference:q} \
          --reference-haplotype {params.reference_name:q} \
          --local-cores {threads} \
          --annotations-only \
          {params.skip}
        test -s {output.success:q}
        test -s {output.annotations:q}
        """


rule build_graph_summary:
    input:
        batches=graph_done_files,
        breakpoints=rules.build_breakpoint_consistency.output.success,
        targets=rules.finalize_partition_targets.output.marker,
        partition_targets=ancient(str(PARTITION_TARGETS)),
        query=rules.validate_and_order_inputs.output.query
    output:
        summary=str(PACKAGE_SUMMARY),
        alternative_intervals=str(PACKAGE_ALTERNATIVE_INTERVALS),
        alternatives=str(PACKAGE_ALTERNATIVES),
        alternatives_fai=str(PACKAGE_ALTERNATIVES_FAI),
        caches=str(PACKAGE_CACHES),
        targets=str(PACKAGE_TARGETS),
        success=str(PACKAGE_SUCCESS)
    threads:
        TOTAL_THREADS
    params:
        script=str(SCRIPT_DIR / "build_local_graphs.py"),
        adjusted=str(PARTITION_LOCAL_ADJUSTED),
        reference=REFERENCE_NAME,
        outdir=str(PACKAGE_DIR),
        graph_folder=str(GRAPH_OUTPUTS),
        reference_argument=(
            "--embed-all-templates" if TEMPLATE_DEFINED else
            "--reference-haplotype " + shlex.quote(REFERENCE_NAME)
        )
    shell:
        """
        {PYTHON:q} {params.script:q} \
          -i {params.adjusted:q} \
          -q {input.query:q} \
          --graph-folder {params.graph_folder:q} \
          {params.reference_argument} \
          -o {params.outdir:q} \
          -j {threads} \
          --resume
        test -s {output.summary:q}
        test -f {output.alternative_intervals:q}
        test -f {output.alternatives:q}
        if test -s {output.alternatives:q}; then
          {SAMTOOLS:q} faidx {output.alternatives:q}
        else
          : > {output.alternatives_fai:q}
        fi
        test -f {output.alternatives_fai:q}
        test -f {output.caches:q}
        cp {input.partition_targets:q} {output.targets:q}
        test -s {output.targets:q}
        touch {output.success:q}
        """
