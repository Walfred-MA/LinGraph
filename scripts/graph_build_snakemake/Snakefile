def sample_fasta(wildcards):
    return ASSEMBLY_BY_NAME[wildcards.sample]


def checkpoint_batch_ids():
    ckpt = checkpoints.make_partition_batches.get()
    with open(ckpt.output.ids, "rt") as handle:
        return [line.strip() for line in handle if line.strip()]


def minset_done_files(wildcards):
    return expand(
        str(GRAPH / "batch_status" / PARTITION_RUN_PROTOCOL / "{batch}.done"),
        batch=checkpoint_batch_ids(),
    )


def graph_done_files(wildcards):
    return expand(
        str(GRAPH / "batch_status" / PARTITION_RUN_PROTOCOL / "{batch}.done"),
        batch=checkpoint_batch_ids(),
    )


def batch_manifest(wildcards):
    ckpt = checkpoints.make_partition_batches.get()
    return str(Path(ckpt.output.batches) / f"{wildcards.batch}.list")


def existing_breakpoint_dependencies(wildcards):
    """Expose restored graph inputs so stale cache success markers rerun."""
    ckpt = checkpoints.finalize_hotspot_fastas.get()
    dependencies = []
    with open(ckpt.output.active, "rt") as handle:
        for raw in handle:
            if not raw.strip():
                continue
            partition = Path(raw.strip().split()[0]).parent.name
            directory = GRAPH_OUTPUTS / partition
            for path in (
                directory / f"{partition}.FA",
                directory / f"{partition}.bed",
                directory / f"{partition}_align.txt",
            ):
                if path.is_file():
                    dependencies.append(str(path))
    return dependencies


