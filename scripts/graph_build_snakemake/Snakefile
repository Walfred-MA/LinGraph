    }]
    PREFLIGHT_FILES.append(str(SCRIPT_DIR / "static_blocks.py"))
PREFLIGHT_ARGUMENTS = " ".join(
    ["--executable " + shlex.quote(value) for value in PREFLIGHT_EXECUTABLES]
    + ["--file " + shlex.quote(value) for value in PREFLIGHT_FILES]
)


rule preflight:
    input:
        rules.validate_and_order_inputs.output
    output:
        str(PREFLIGHT)
    params:
        helper=HELPER,
        arguments=PREFLIGHT_ARGUMENTS,
        preparation=PREPARATION_DIR
    shell:
        """
        {PYTHON:q} {params.helper:q} preflight \
          {params.arguments} \
          --output {output:q} \
          --preparation-folder {params.preparation:q}
        """


FIXED_FASTA_ARGUMENTS = [
    "--input " + shlex.quote(f"{REFERENCE_NAME}={REFERENCE_FASTA}")
]
