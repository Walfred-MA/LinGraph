    VALIDATION_FASTAS.extend(row.fasta for row in NOVEL_ASSEMBLIES)
    VALIDATION_INDEXES.extend(row.fai for row in NOVEL_ASSEMBLIES)


rule validate_and_order_inputs:
    input:
        fastas=VALIDATION_FASTAS,
        indexes=VALIDATION_INDEXES,
        query=QUERY_INPUT,
        contract=HELPER
    output:
        query=str(NORMALIZED_QUERY),
        metadata=str(INPUT_METADATA)
    params:
        helper=HELPER,
        query_input=QUERY_INPUT,
        working_directory=INPUT_WORKING_DIRECTORY,
        reference=REFERENCE_ARGUMENT,
        preparation=PREPARATION_DIR,
        template="--template-defined" if TEMPLATE_DEFINED else ""
    shell:
        """
        {PYTHON:q} {params.helper:q} prepare-inputs \
          --query-paths {params.query_input:q} \
          --working-directory {params.working_directory:q} \
          --reference {params.reference:q} \
          --output {output.query:q} \
          --metadata {output.metadata:q} \
          --preparation-folder {params.preparation:q} \
          {params.template}
        """


