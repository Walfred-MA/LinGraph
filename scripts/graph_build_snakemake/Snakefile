    FIXED_FASTA_ARGUMENTS.append(
        "--input " + shlex.quote(f"alternative={ALTERNATIVE_FASTA}")
    )
FIXED_FASTA_ARGUMENTS = " ".join(FIXED_FASTA_ARGUMENTS)


rule combine_fixed_reference:
    input:
        fastas=([REFERENCE_FASTA] + ([ALTERNATIVE_FASTA] if ALTERNATIVE_FASTA else [])),
        indexes=([ASSEMBLIES[0].fai] + ([ALTERNATIVE_FAI] if ALTERNATIVE_FAI else [])),
        # Existing catalogs must acquire the explicit imported-template policy.
        policy=str(SCRIPT_DIR / "fixed_alternatives.py"),
        helper=HELPER,
        ready=rules.preflight.output
    output:
        str(FIXED_FASTA)
    params:
        helper=HELPER,
        arguments=FIXED_FASTA_ARGUMENTS
    shell:
        """
        {PYTHON:q} {params.helper:q} combine-fastas \
          {params.arguments} \
          --output {output:q}
        """


rule faidx_fixed_reference:
    input:
        rules.combine_fixed_reference.output
    output:
        str(FIXED_FASTA_FAI)
    params:
        helper=HELPER,
        samtools=SAMTOOLS
    shell:
        """
        {PYTHON:q} {params.helper:q} faidx \
          --samtools {params.samtools:q} \
          --fasta {input:q} \
          --output {output:q}
        """


if FIND_NOVEL_LOCI:
    NOVEL_EXCLUDE_ARGUMENTS = " ".join(
        ["--exclude-name " + shlex.quote(REFERENCE_NAME)]
        + ["--exclude-fasta " + shlex.quote(REFERENCE_FASTA)]
        + (["--exclude-fasta " + shlex.quote(ALTERNATIVE_FASTA)] if ALTERNATIVE_FASTA else [])
    )
    NOVEL_KEEP_ARGUMENT = "--keep-work" if KEEP_NOVEL_WORK else ""
    NOVEL_BLAST_ARGUMENT = "--skip-blastn" if SKIP_BLASTN else ""

    rule discover_novel_loci:
        input:
            fixed=rules.combine_fixed_reference.output,
            fixed_fai=rules.faidx_fixed_reference.output,
            query=NOVEL_QUERY_INPUT,
            fastas=[row.fasta for row in NOVEL_ASSEMBLIES],
            indexes=[row.fai for row in NOVEL_ASSEMBLIES]
        output:
            fasta=str(DISCOVERED_NOVELS),
            fai=str(DISCOVERED_NOVELS_FAI),
            covered_bed=str(DISCOVERED_NOVELS_COVERED_BED)
        threads:
            min(TOTAL_THREADS, NOVEL_SLURM_CPUS) if SLURM_ENABLED else TOTAL_THREADS
        resources:
            slurm_jobs=1 if SLURM_ENABLED else 0
        params:
            script=str(HELPER_DIR / "discover_novel_loci.py"),
            minsetref=str(SCRIPT_DIR / "minsetref.py"),
            workdir=str(NOVEL_WORKDIR),
            excludes=NOVEL_EXCLUDE_ARGUMENTS,
            keep=NOVEL_KEEP_ARGUMENT,
            blast=NOVEL_BLAST_ARGUMENT,
            jobs=NOVEL_LOCUS_JOBS,
            working_directory=INPUT_WORKING_DIRECTORY,
            slurm=lambda wildcards: slurm_prefix(
                "discover-novel-loci", NOVEL_SLURM_CPUS,
                NOVEL_SLURM_MEMORY)
        shell:
            """
            {params.slurm} {PYTHON:q} {params.script:q} \
              --fixed-reference {input.fixed:q} \
              --assemblies {input.query:q} \
              --working-directory {params.working_directory:q} \
              --output {output.fasta:q} \
              --covered-bed {output.covered_bed:q} \
              --workdir {params.workdir:q} \
              --kmer-ref-cleaner {KMERREFCLEANER:q} \
              --minsetref {params.minsetref:q} \
              --python {PYTHON:q} \
              --samtools {SAMTOOLS:q} \
              --threads {threads} \
              --jobs {params.jobs} \
              --context-flank 30000 \
              {params.excludes} {params.keep} {params.blast}
            test -f {output.fasta:q}
            test -f {output.fai:q}
            test -f {output.covered_bed:q}
            """


CATALOG_FASTA_INPUTS = [str(FIXED_FASTA)]
CATALOG_FAI_INPUTS = [str(FIXED_FASTA_FAI)]
