def slurm_integer_option(arguments, long_name, short_name, default):
    """Read an integer sbatch option in --x=N, --x N, -cN, or -c N form."""
    for index, value in enumerate(arguments):
        if value.startswith(long_name + "="):
            return int(value.split("=", 1)[1])
        if value == long_name or value == short_name:
            if index + 1 >= len(arguments):
                raise ValueError("{} requires an integer value".format(value))
            return int(arguments[index + 1])
        if value.startswith(short_name) and value != short_name:
            return int(value[len(short_name):])
    return default


MINSET_AVAILABLE_CPUS = (
    slurm_integer_option(
        SLURM_ARGS, "--cpus-per-task", "-c", MINSET_SLURM_CPUS
    )
    if SLURM_ENABLED else TOTAL_THREADS
)
if MINSET_AVAILABLE_CPUS < 1:
    raise ValueError("available minset job CPUs must be positive")
if MINSET_PARTITION_JOBS < 1:
    raise ValueError("minset partition jobs must be positive")
if MINSET_PARTITION_JOBS > MINSET_AVAILABLE_CPUS:
    raise ValueError("minset partition jobs exceeds available job CPUs")
if MINSET_AVAILABLE_CPUS % MINSET_PARTITION_JOBS:
    raise ValueError(
        "available minset job CPUs ({}) must divide evenly among {} partition "
        "jobs".format(MINSET_AVAILABLE_CPUS, MINSET_PARTITION_JOBS)
    )
MINSET_PARTITION_THREADS = MINSET_AVAILABLE_CPUS // MINSET_PARTITION_JOBS
if TOTAL_THREADS < 4:
    raise ValueError("threads must be at least 4 for the partition-novelty stages")
if PARTITION_BATCHES < 1:
    raise ValueError("partition_batches must be positive")
if ALIGNMENT_TIMEOUT < 1:
    raise ValueError("alignment_timeout must be positive")
if NOVEL_LOCUS_JOBS < 1:
    raise ValueError("novel_locus_jobs must be positive")
if (NOVEL_SLURM_CPUS < 1 or KMERSEARCH_SLURM_CPUS < 1 or
        MINSET_SLURM_CPUS < 1):
    raise ValueError("Slurm CPU requests must be positive")
if SLURM_ENABLED and not SLURM_ARGS and not SLURM_ACCOUNT:
    raise ValueError("slurm_account must be set when Slurm submission is enabled")
if SLURM_ENABLED and not SLURM_ARGS and not SLURM_PARTITION:
    raise ValueError("slurm_partition must be set when Slurm submission is enabled")
if SLURM_ENABLED and not SLURM_TIME:
    raise ValueError("slurm_time must be set when Slurm submission is enabled")

EXECUTABLES = config.get("executables", {}) or {}


def executable(name, same_script_folder=False):
    if name in EXECUTABLES:
        value = str(EXECUTABLES[name])
        return resolve_path(value, SCRIPT_DIR) if os.path.sep in value else value
    return str(SCRIPT_DIR / name) if same_script_folder else name


