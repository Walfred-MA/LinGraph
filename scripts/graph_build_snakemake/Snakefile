def slurm_prefix(job_name, cpus, memory):
    if not SLURM_ENABLED:
        return ""
    command = [
        PYTHON, HELPER, "run-slurm",
        "--sbatch", SBATCH,
        "--cpus", str(cpus),
        "--memory", str(memory),
    ]
    if SLURM_ACCOUNT:
        command.extend(["--account", SLURM_ACCOUNT])
    if SLURM_TIME:
        command.extend(["--time", SLURM_TIME])
    if SLURM_PARTITION:
        command.extend(["--partition", SLURM_PARTITION])
    command.extend(
        "--sbatch-arg=" + argument for argument in SLURM_ARGS
    )
    command.extend([
        "--job-name", job_name,
        "--log-dir", str(GRAPH / "slurm_logs"),
        "--",
    ])
    return shlex.join(command)

