SLURM_TIME = str(RUN.get("slurm_time", "200:00:00")).strip()
SLURM_PARTITION = str(RUN.get("slurm_partition", "")).strip()
SLURM_ARGS_TEXT = str(RUN.get("slurm_args", "")).strip()
SLURM_ARGS = shlex.split(SLURM_ARGS_TEXT) if SLURM_ARGS_TEXT else []
PYTHON = sys.executable
WAIT_NONEMPTY = shlex.join([
    PYTHON, str(SLURM_HELPER), "wait-nonempty",
    "--timeout", "60", "--interval", "1",
])


def slurm_prefix(job_name, cpus, memory):
    if not SLURM_ENABLED:
        return ""
    command = [
        PYTHON, str(SLURM_HELPER), "run-slurm",
        "--sbatch", "sbatch",
        "--cpus", str(cpus),
        "--memory", str(memory),
    ]
    if SLURM_ACCOUNT:
        command.extend(["--account", SLURM_ACCOUNT])
    if SLURM_TIME:
        command.extend(["--time", SLURM_TIME])
    if SLURM_PARTITION:
        command.extend(["--partition", SLURM_PARTITION])
    command.extend("--sbatch-arg=" + argument for argument in SLURM_ARGS)
    command.extend([
        "--job-name", job_name,
        "--log-dir", str(OUT / "slurm_logs"),
        "--",
    ])
    return shlex.join(command)


def merge_chrom_runner():
    command = [
        PYTHON, str(MERGE_STAGE_HELPER), "run-chroms",
        "--chrom-list", str(MERGE_CHROMS),
        "--shards-dir", str(MERGE_TMPDIR),
        "--marker", str(MERGE_CHROMS_COMPLETE),
        *(["--slurm", "--sbatch", "sbatch"] if SLURM_ENABLED else []),
        "--cpus", str(MERGE_PROCESSES),
        "--memory", MERGE_CHROM_MEMORY,
        "--chr1-resource-multiplier", str(MERGE_CHR1_RESOURCE_MULTIPLIER),
        "--jobs", str(MERGE_CHROM_JOBS),
        "--job-name", "merge-cohort-chrom",
        "--log-dir", str(OUT / "slurm_logs"),
    ]
    if SLURM_ACCOUNT:
        command.extend(["--account", SLURM_ACCOUNT])
    if SLURM_TIME:
        command.extend(["--time", SLURM_TIME])
    if SLURM_PARTITION:
        command.extend(["--partition", SLURM_PARTITION])
    command.extend("--sbatch-arg=" + argument for argument in SLURM_ARGS)
    command.extend([
        "--", PYTHON, str(MERGE_SCRIPT),
        "--stage", "chrom", "--shards-dir", str(MERGE_TMPDIR),
        "--sv", "--minsvsize", str(MERGE_MINSVSIZE),
        "--merge-distance", str(MERGE_DISTANCE),
        "--size-similarity", str(MERGE_SIZE_SIMILARITY),
        "--sequence-similarity", str(MERGE_SEQUENCE_SIMILARITY),
        "--var-in-insert", str(MERGE_VAR_IN_INSERT),
        "--processes", str(MERGE_PROCESSES),
        "--kmermatch", str(RUN["kmermatch"]),
    ])
    if MERGE_EMIT_SMALL:
        command.append("--output-small")
    if MERGE_MODE == "all":
        command.extend(["--insertion-snps", str(MERGE_TMPDIR / "insertion_snps")])
    return shlex.join(command)


def extraction_batches():
    return [
        (
            "batch{:06d}".format(index // EXTRACT_BATCH_SIZE + 1),
            PARTITIONS[index:index + EXTRACT_BATCH_SIZE],
        )
        for index in range(0, len(PARTITIONS), EXTRACT_BATCH_SIZE)
    ]


def match_batches():
    count = min(int(RUN["match_batches"]), len(PARTITIONS))
    base, remainder = divmod(len(PARTITIONS), count)
    output = []
    start = 0
    for index in range(count):
        size = base + (1 if index < remainder else 0)
        output.append((
            "batch{:06d}".format(index + 1),
            PARTITIONS[start:start + size],
        ))
        start += size
    return output


