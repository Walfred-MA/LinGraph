def sample_fasta(wildcards):
    return ancient(ASSEMBLIES[wildcards.sample]["fasta"])


def sample_fai(wildcards):
    return ancient(ASSEMBLIES[wildcards.sample]["fai"])


def sample_path(wildcards, suffix):
    return str(SAMPLES_ROOT / wildcards.sample / (wildcards.sample + suffix))


rule all:
    input:
        str(COMPLETE),
        FINAL_VCFS,
        SAMPLE_VCFS


rule prepare_calling_layout:
    input:
        layout_config=ancient(LAYOUT_CONFIG_PATH),
        query=ancient(RUN["query_paths"]),
        partitions=ancient(RUN["partition_list"]),
    output:
        layout=str(LAYOUT),
        active=str(ACTIVE_PARTITIONS),
        normalized=str(NORMALIZED_QUERY),
        selected_query=str(SELECTED_QUERY),
        selected_samples=str(SELECTED_SAMPLES),
        match_lists=MATCH_LISTS,
        extraction_lists=EXTRACTION_LISTS,
    threads: 1
    shell:
        """
        {PYTHON:q} {HELPER:q} prepare --run-config {input.layout_config:q}
        {WAIT_NONEMPTY} {output.layout:q} {output.active:q} \
          {output.normalized:q} {output.selected_query:q} \
          {output.selected_samples:q}
        """


rule match_partition_blocks_batch:
    input:
        # Static layout inputs are existence-based checkpoints. A newly
        # completed graph protocol does invalidate the batch so its internal
        # per-partition checks can refresh stale RefMatch tables.
        layout_config=ancient(LAYOUT_CONFIG_PATH),
        layout=ancient(rules.prepare_calling_layout.output.layout),
        query=ancient(rules.prepare_calling_layout.output.normalized),
        selected=ancient(rules.prepare_calling_layout.output.selected_samples),
        graph_complete=str(SOURCE_GRAPHS_COMPLETE),
        partition_list=lambda wc: ancient(str(
            INPUTS / "match_batches" / (wc.batch + ".list")
        )),
        script=ancient(str(SCRIPT_DIR / "match_partition_blocks.py")),
        graphfixbreaks=ancient(str(SCRIPT_DIR / "gfixbreaks.py")),
        kmermatch=ancient(RUN["kmermatch"]),
    output:
        status=str(OUT / "batch_status" / "match" / "{batch}.tsv"),
    threads: 1 if SLURM_ENABLED else MATCH_THREADS
    resources:
        slurm_jobs=1 if SLURM_ENABLED else 0
    params:
        slurm=lambda wc: slurm_prefix(
            "match-" + wc.batch, MATCH_THREADS, RUN["match_memory"]
        ),
    shell:
        """
        {params.slurm} {PYTHON:q} {input.script:q} \
          --partition-list {input.partition_list:q} \
          --graph-folder {SOURCE_GRAPHS:q} \
          --output-graph-folder {CALL_GRAPHS:q} \
          --query-paths {input.query:q} \
          --sample-list {input.selected:q} \
          --reference-haplotype {REFERENCE:q} \
          --manifest {output.status:q} \
          --graphfixbreaks {input.graphfixbreaks:q} \
          --kmermatch {input.kmermatch:q} \
          --jobs {MATCH_THREADS} --resume --strict
        {WAIT_NONEMPTY} {output.status:q}
        {PYTHON:q} {HELPER:q} validate-match-batch \
          --run-config {RUN_CONFIG_PATH:q} \
          --partition-list {input.partition_list:q} \
          --manifest {output.status:q}
        """


rule extract_and_concatenate_samples:
    input:
        stage_config=ancient(LAYOUT_CONFIG_PATH),
        layout=ancient(rules.prepare_calling_layout.output.layout),
        helper=ancient(str(HELPER)),
        # Rebuilt graph matches change the extracted sample alignments.
        matches=MATCH_STATUSES,
        batch_lists=[ancient(path) for path in EXTRACTION_LISTS],
    output:
        marker=str(EXTRACTION_COMPLETE),
        refmatches=expand(
            str(SAMPLES_ROOT / "{sample}" / "{sample}.refmatch.tsv"),
            sample=SAMPLES,
        ),
        alignments=expand(
            str(SAMPLES_ROOT / "{sample}" / "{sample}.align.txt"),
            sample=SAMPLES,
        ),
    threads: 1 if SLURM_ENABLED else IO_JOBS
    resources:
        io_jobs=IO_JOBS,
        slurm_jobs=1 if SLURM_ENABLED else 0
    params:
        slurm=slurm_prefix(
            "extract-samples", IO_JOBS, RUN["extraction_memory"]
        ),
    shell:
        """
        {params.slurm} {PYTHON:q} {HELPER:q} extract-all \
          --run-config {RUN_CONFIG_PATH:q} \
          --marker {output.marker:q} \
          --jobs {IO_JOBS}
        {WAIT_NONEMPTY} {output.marker:q}
        """


# Script mtimes must not invalidate completed cohort stages. Keep scripts as
# required ancient inputs; data and semantic stage configs retain their checks.
rule discover_local_reference_templates:
    input:
        stage_config=LOCAL_TEMPLATE_CONFIG_PATH,
        extraction=rules.extract_and_concatenate_samples.output.marker,
        reference_align=ancient(str(
            SAMPLES_ROOT / REFERENCE / (REFERENCE + ".align.txt")
        )),
        graph_list=ancient(str(ACTIVE_PARTITIONS)),
        script=ancient(str(SCRIPT_DIR / "local_reference_templates.py")),
        contig_filter=ancient(str(SCRIPT_DIR / "assembly_contigs.py")),
    output:
        fasta=str(RAW_LOCAL_TEMPLATES),
        fai=str(RAW_LOCAL_TEMPLATES) + ".fai",
    threads: 1
    resources:
        io_jobs=1,
        slurm_jobs=1 if SLURM_ENABLED else 0
    params:
        disabled="" if LOCAL_TEMPLATE_FALLBACK else "--disabled",
        slurm=slurm_prefix(
            "local-templates", 1, RUN["extraction_memory"]
        ),
    shell:
        """
        {params.slurm} {PYTHON:q} {input.script:q} \
          --graph-folder {SOURCE_GRAPHS:q} \
          --graph-list {input.graph_list:q} \
          --align-ref {input.reference_align:q} \
          --reference-haplotype {REFERENCE:q} \
          --output {output.fasta:q} {params.disabled}
        {WAIT_NONEMPTY} {output.fasta:q} {output.fai:q}
        """


rule local_reference_templates:
    input:
        raw=rules.discover_local_reference_templates.output.fasta,
        stage_config=LOCAL_TEMPLATE_CONFIG_PATH,
        query=str(INPUTS / "query_paths.normalized.txt"),
        reference=ASSEMBLIES[REFERENCE]["fasta"],
        sources=[row["fasta"] for row in ASSEMBLIES.values()],
        source_indexes=[row["fai"] for row in ASSEMBLIES.values()],
        script=ancient(str(SCRIPT_DIR / "lift_local_templates.py")),
        localization=ancient(str(SCRIPT_DIR / "minsetref_localize.py")),
        aligner=ancient(str(SCRIPT_DIR / "minsetref_align.py")),
    output:
        fasta=str(LOCAL_TEMPLATES),
        fai=str(LOCAL_TEMPLATES) + ".fai",
    threads: 1 if SLURM_ENABLED else SAMPLE_THREADS
    resources:
        io_jobs=1,
        slurm_jobs=1 if SLURM_ENABLED else 0
    params:
        slurm=slurm_prefix("lift-local-templates", SAMPLE_THREADS, RUN["extraction_memory"])
    shell:
        """
        {params.slurm} {PYTHON:q} {input.script:q} \
          --input {input.raw:q} --assemblies {input.query:q} \
          --reference-fasta {input.reference:q} --reference-haplotype {REFERENCE:q} \
          --threads {SAMPLE_THREADS} --output {output.fasta:q}
        {WAIT_NONEMPTY} {output.fasta:q} {output.fai:q}
        """


rule genomelift_sample:
    input:
        stage_config=ancient(LIFTOVER_CONFIG_PATH),
        refmatch=lambda wc: str(
            SAMPLES_ROOT / wc.sample / (wc.sample + ".refmatch.tsv")
        ),
        align=lambda wc: str(
            SAMPLES_ROOT / wc.sample / (wc.sample + ".align.txt")
        ),
        reference=ancient(RUN["reference_fasta"]),
        reference_fai=ancient(RUN["reference_fai"]),
        script=ancient(str(SCRIPT_DIR / "GenomeLift.py")),
    output:
        str(SAMPLES_ROOT / "{sample}" / "{sample}.genomelift.tsv"),
    threads: 1 if SLURM_ENABLED else SAMPLE_THREADS
    resources:
        slurm_jobs=1 if SLURM_ENABLED else 0
    params:
        tmpdir=lambda wc: str(
            SAMPLES_ROOT / wc.sample / (wc.sample + ".GenomeLiftTemp")
        ),
        non_reference=(
            "--non-reference-tags "
            + shlex.quote(LIFTOVER_RUN.get("non_reference_tags", ""))
            if LIFTOVER_RUN.get("non_reference_tags") else ""
        ),
        slurm=lambda wc: slurm_prefix(
            "lift-" + wc.sample,
            SAMPLE_THREADS,
            RUN["genomelift_memory"],
        ),
    shell:
        """
        {params.slurm} {PYTHON:q} {input.script:q} \
          --input {input.refmatch:q} --alignments {input.align:q} \
          --output {output:q} \
          --refhaplo {REFERENCE:q} \
          --threads {SAMPLE_THREADS} --parallel-unit contig \
          --tmpdir {params.tmpdir:q} --max-extension {LIFT_MAX_EXTENSION} \
          --filter-hg38-alts {params.non_reference}
        {WAIT_NONEMPTY} {output:q}
        """


rule graphcigartoref_sample:
    input:
        stage_config=GRAPHCIGAR_CONFIG_PATH,
        alternative=(ALTERNATIVE_BED,) if ALTERNATIVE_BED else (),
        genomelift=rules.genomelift_sample.output,
        query_align=lambda wc: ancient(str(
            SAMPLES_ROOT / wc.sample / (wc.sample + ".align.txt")
        )),
        reference_align=ancient(str(
            SAMPLES_ROOT / REFERENCE / (REFERENCE + ".align.txt")
        )),
        query_fasta=sample_fasta,
        query_fai=sample_fai,
        reference=ancient(RUN["reference_fasta"]),
        reference_fai=ancient(RUN["reference_fai"]),
        graph_list=ancient(str(ACTIVE_PARTITIONS)),
        graph_summary=(
            tuple(ancient(str(path)) for path in GRAPH_SUMMARY_FILES)
            if GRAPH_SUMMARY_ENABLED else ()
        ),
        layout=ancient(str(LAYOUT)),
        local_templates=rules.local_reference_templates.output.fasta,
        local_templates_fai=rules.local_reference_templates.output.fai,
        script=ancient(str(GRAPHCIGAR_SCRIPT)),
    output:
        str(SAMPLES_ROOT / "{sample}" / "{sample}.graphcigartoref.tsv"),
    threads: 1 if SLURM_ENABLED else SAMPLE_THREADS
    resources:
        slurm_jobs=1 if SLURM_ENABLED else 0
    params:
        graph_summary=(
            "--graph-summary " + shlex.quote(str(GRAPH_SUMMARY))
            if GRAPH_SUMMARY_ENABLED else ""
        ),
        slurm=lambda wc: slurm_prefix(
            "gcigar-" + wc.sample,
            SAMPLE_THREADS,
            RUN["graphcigar_memory"],
        ),
    shell:
        """
        {params.slurm} {PYTHON:q} {input.script:q} \
          --genomelift {input.genomelift:q} \
          --align-query {input.query_align:q} \
          --align-ref {input.reference_align:q} \
          --query-genome {wildcards.sample:q} --refhaplo {REFERENCE:q} \
          --fasta-query {input.query_fasta:q} \
          --graph-folder {SOURCE_GRAPHS:q} \
          {params.graph_summary} \
          --graph-list {input.graph_list:q} \
          --reference {input.reference:q} --output {output:q} \
          --local-reference-templates {input.local_templates:q} \
          --processes {SAMPLE_THREADS} \
          {ALTERNATIVE_OPTION} \
          --max-extension {GRAPH_MAX_EXTENSION} \
          --cross-validation-extension {CROSS_VALIDATION_EXTENSION} \
          {GRAPHCIGAR_REALIGNMENT_OPTION} \
          --buffer-size {BUFFER_SIZE} --buffer-bytes {BUFFER_BYTES} \
          --progress-every {PROGRESS_EVERY} \
          --progress-seconds {PROGRESS_SECONDS} \
          --maxtasksperchild {MAXTASKSPERCHILD}
        {WAIT_NONEMPTY} {output:q}
        """


rule fill_graphcigartoref_gaps_sample:
    input:
        graphcigar=rules.graphcigartoref_sample.output,
        genomelift=rules.genomelift_sample.output,
        query_fasta=sample_fasta,
        query_fai=sample_fai,
        reference=ancient(RUN["reference_fasta"]),
        reference_fai=ancient(RUN["reference_fai"]),
        local_templates=rules.local_reference_templates.output.fasta,
        local_templates_fai=rules.local_reference_templates.output.fai,
        script=ancient(str(SCRIPT_DIR / "fill_graphcigartoref_gaps.py")),
    output:
        graphcigar=str(
            SAMPLES_ROOT / "{sample}" / "{sample}.graphcigartoreffix.tsv"
        ),
        genomeliftfix=str(
            SAMPLES_ROOT / "{sample}" / "{sample}.genomeliftfix.tsv"
        ),
    threads: 1 if SLURM_ENABLED else SAMPLE_THREADS
    resources:
        slurm_jobs=1 if SLURM_ENABLED else 0
    params:
        slurm=lambda wc: slurm_prefix(
            "gapfill-" + wc.sample,
            SAMPLE_THREADS,
            RUN["gapfill_memory"],
        ),
    shell:
        """
        {params.slurm} {PYTHON:q} {input.script:q} \
          --input {input.graphcigar:q} \
          --genomelift {input.genomelift:q} \
          --genomelift-fix-output {output.genomeliftfix:q} \
          --query-genome {wildcards.sample:q} \
          --fasta-query {input.query_fasta:q} \
          --reference {input.reference:q} --output {output.graphcigar:q} \
          --local-reference-templates {input.local_templates:q} \
          --processes {SAMPLE_THREADS}
        {WAIT_NONEMPTY} {output.graphcigar:q}
        test -s {output.genomeliftfix:q}
        """


rule graphreftovcf_sample:
    input:
        stage_config=VCF_CONFIG_PATH,
        graphcigar=rules.fill_graphcigartoref_gaps_sample.output.graphcigar,
        genomelift=rules.genomelift_sample.output,
        genomeliftfix=rules.fill_graphcigartoref_gaps_sample.output.genomeliftfix,
        query_fasta=sample_fasta,
        query_fai=sample_fai,
        reference=ancient(RUN["reference_fasta"]),
        reference_fai=ancient(RUN["reference_fai"]),
        local_templates=rules.local_reference_templates.output.fasta,
        local_templates_fai=rules.local_reference_templates.output.fai,
        script=ancient(str(SCRIPT_DIR / "graphreftovcf_persample.py")),
    output:
        str(SAMPLES_ROOT / "{sample}" / "{sample}.vcf"),
    threads: 1 if SLURM_ENABLED else SAMPLE_THREADS
    resources:
        slurm_jobs=1 if SLURM_ENABLED else 0
    params:
        sv_only=(
            "--svcutoff {}".format(int(SV_ONLY_CUTOFF))
            if SV_ONLY_CUTOFF is not None else ""
        ),
        sequence_options=" ".join(
            option for option in (
                "--seqcompress" if SEQCOMPRESS else "",
                "--PAtag" if PA_TAG else "--noPAtag",
            ) if option
        ),
        slurm=lambda wc: slurm_prefix(
            "vcf-" + wc.sample,
            SAMPLE_THREADS,
            RUN["vcf_memory"],
        ),
    shell:
        """
        {params.slurm} {PYTHON:q} {input.script:q} \
          --input {input.graphcigar:q} --ref {input.reference:q} \
          --local-reference-templates {input.local_templates:q} \
          --fasta-query {input.query_fasta:q} \
          --coord-map {input.genomelift:q},{input.genomeliftfix:q} \
          --output {output:q} \
          --columns {wildcards.sample:q} --processes {SAMPLE_THREADS} \
          --format-processes {FORMAT_PROCESSES} \
          --edge-blackregion {EDGE_BLACKREGION} \
          {CONFLICT_POLICY_OPTION} \
          {VCF_REALIGNMENT_OPTION} \
          {SEPARATE_ADJACENT_INDELS_OPTION} \
          {params.sv_only} \
          {params.sequence_options} \
          --max-impute {VCF_MAX_IMPUTE}
        {WAIT_NONEMPTY} {output:q}
        """


rule merge_vcf_list:
    input:
        vcfs=SAMPLE_VCFS
    output:
        str(MERGE_VCF_LIST)
    run:
        destination = Path(str(output[0]))
        destination.parent.mkdir(parents=True, exist_ok=True)
        temporary = destination.with_name(
            destination.name + ".tmp." + str(os.getpid())
        )
        try:
            with temporary.open("wt", encoding="utf-8") as handle:
                for path in input.vcfs:
                    handle.write(str(Path(str(path)).resolve()) + "\n")
            os.replace(str(temporary), str(destination))
        finally:
            try:
                temporary.unlink()
            except FileNotFoundError:
                pass


def merge_temporary(path):
    # Missing temporary outputs must not cause a completed cohort to remerge.
    return str(path) if as_bool(RUN.get("keep_merge_tmpdir", False)) else temp(str(path))


if MERGE_MODE != "snp":
    rule graphvcfmerge_scan:
        input:
            stage_config=MERGE_CONFIG_PATH,
            vcf_list=rules.merge_vcf_list.output,
            script=ancient(str(MERGE_SCRIPT)),
        output:
            chroms=merge_temporary(MERGE_CHROMS),
            raw=[merge_temporary(SMALL_MERGE_TMPDIR / "raw.manifest.json")] if MERGE_MODE == "all" else [],
        threads: 1 if SLURM_ENABLED else MERGE_SCAN_PROCESSES
        resources:
            slurm_jobs=1 if SLURM_ENABLED else 0
        params:
            slurm=slurm_prefix(
                "merge-cohort-scan", MERGE_SCAN_PROCESSES,
                MERGE_SCAN_MEMORY,
            ),
            snps=shlex.join(["--snp-shards-dir", str(SMALL_MERGE_TMPDIR)]) if MERGE_MODE == "all" else "",
        shell:
            """
            {params.slurm} {PYTHON:q} {input.script:q} \
              -I {input.vcf_list:q} --stage scan \
              --shards-dir {MERGE_TMPDIR:q} --sv \
              --processes {MERGE_SCAN_PROCESSES} {params.snps}
            test -e {output.chroms:q}
            """


    rule graphvcfmerge_chroms:
        input:
            stage_config=MERGE_CONFIG_PATH,
            chroms=rules.graphvcfmerge_scan.output.chroms,
            script=ancient(str(MERGE_SCRIPT)),
            helper=ancient(str(MERGE_STAGE_HELPER)),
        output:
            merge_temporary(MERGE_CHROMS_COMPLETE),
        threads: 1 if SLURM_ENABLED else MERGE_THREADS
        resources:
            slurm_jobs=1 if SLURM_ENABLED else 0
        params:
            runner=merge_chrom_runner(),
        shell:
            """
            {params.runner}
            {WAIT_NONEMPTY} {output:q}
            """


    rule graphvcfmerge_cohort:
        input:
            stage_config=MERGE_CONFIG_PATH,
            chroms_complete=rules.graphvcfmerge_chroms.output,
            script=ancient(str(MERGE_SCRIPT)),
        output:
            main=merge_temporary(COHORT_VCF),
            auxiliary=[merge_temporary(path) for path in (SV_SMALL_VCFS +
                       ([str(MERGE_TMPDIR / "insertion_snps/manifest.json")] if MERGE_MODE == "all" else []))],
        threads: 1 if SLURM_ENABLED else min(8, MERGE_PROCESSES)
        resources:
            slurm_jobs=1 if SLURM_ENABLED else 0
        params:
            slurm=slurm_prefix(
                "merge-cohort-concat", min(8, MERGE_PROCESSES), MERGE_CONCAT_MEMORY
            ),
            workers=lambda wc, threads: min(8, MERGE_PROCESSES) if SLURM_ENABLED else threads,
            snps=shlex.join(["--insertion-snps", str(MERGE_TMPDIR / "insertion_snps")]) if MERGE_MODE == "all" else "",
        shell:
            """
            {params.slurm} {PYTHON:q} {input.script:q} \
              --stage concat --shards-dir {MERGE_TMPDIR:q} \
              --output {output.main:q} --sv --processes {params.workers} {MERGE_SMALL_OPTION} {params.snps}
            {WAIT_NONEMPTY} {output.main:q}
            """

if SMALL_VCFS:
    checkpoint graphvcfmerge_small_scan:
        input:
            raw=rules.graphvcfmerge_scan.output.raw if MERGE_MODE == "all" else [],
            stage_config=MERGE_CONFIG_PATH,
            vcfs=SAMPLE_VCFS,
            vcf_list=rules.merge_vcf_list.output,
            script=ancient(str(SMALL_MERGE_SCRIPT)),
        output:
            manifest=str(SMALL_MERGE_MANIFEST),
            shards=merge_temporary(SMALL_MERGE_TMPDIR / "manifest.json"),
        threads: 1 if SLURM_ENABLED else MERGE_SCAN_PROCESSES
        resources:
            slurm_jobs=1 if SLURM_ENABLED else 0
        params:
            slurm=slurm_prefix("merge-small-scan", MERGE_SCAN_PROCESSES, MERGE_SCAN_MEMORY),
            stage=shlex.join(["--stage", "prepare", "--raw-manifest", str(SMALL_MERGE_TMPDIR / "raw.manifest.json")]) if MERGE_MODE == "all" else "--stage scan",
        shell:
            """
            {params.slurm} {PYTHON:q} {input.script:q} -I {input.vcf_list:q} \
              {params.stage} --shards-dir {SMALL_MERGE_TMPDIR:q} \
              --manifest-output {output.manifest:q} \
              --svcutoff {MERGE_MINSVSIZE} --processes {MERGE_SCAN_PROCESSES} --snp-only
            """


    rule graphvcfmerge_small_chrom:
        input:
            manifest=lambda wc: checkpoints.graphvcfmerge_small_scan.get().output.shards,
            script=ancient(str(SMALL_MERGE_SCRIPT)),
        output:
            snp=merge_temporary(SMALL_MERGE_TMPDIR / "{generation}" / "parts" / "{chrom}.snp.part"),
            indel=merge_temporary(SMALL_MERGE_TMPDIR / "{generation}" / "parts" / "{chrom}.indel.part"),
        wildcard_constraints:
            generation="scan-[^/]+",
            chrom="[0-9a-f]{64}",
        threads: 1 if SLURM_ENABLED else 32
        resources:
            slurm_jobs=1 if SLURM_ENABLED else 0
        params:
            slurm=lambda wc: slurm_prefix("merge-small-" + wc.chrom[:12], 32, "64G"),
            workers=lambda wc, threads: 32 if SLURM_ENABLED else threads,
        shell:
            """
            {params.slurm} {PYTHON:q} {input.script:q} \
              --stage chrom --shards-dir {SMALL_MERGE_TMPDIR:q} --chrom {wildcards.chrom:q} --processes {params.workers}
            """


    def small_merge_parts(wildcards):
        manifest_path = checkpoints.graphvcfmerge_small_scan.get().output.manifest
        with open(manifest_path) as handle:
            manifest = json.load(handle)
        return [str(Path(manifest["directory"]) / "parts" / (key + "." + kind + ".part"))
                for key in manifest["chroms"] for kind in ("snp", "indel")]


    rule graphvcfmerge_small_cohort:
        input:
            parts=small_merge_parts,
            insertions=[str(MERGE_TMPDIR / "insertion_snps/manifest.json")] if MERGE_MODE == "all" else [],
            manifest=lambda wc: checkpoints.graphvcfmerge_small_scan.get().output.shards,
            script=ancient(str(SMALL_MERGE_SCRIPT)),
        output:
            snp=merge_temporary(COHORT_SNP_VCF),
            indel=merge_temporary(COHORT_INDEL_VCF),
        threads: 1
        resources:
            slurm_jobs=1 if SLURM_ENABLED else 0
        params:
            prefix=str(COHORT_SNP_VCF).removesuffix(".snp.vcf"),
            slurm=slurm_prefix("merge-small-concat", 1, MERGE_CONCAT_MEMORY),
            snps=shlex.join(["--insertion-snps", str(MERGE_TMPDIR / "insertion_snps")]) if MERGE_MODE == "all" else "",
        shell:
            """
            {params.slurm} {PYTHON:q} {input.script:q} \
              --stage concat --shards-dir {SMALL_MERGE_TMPDIR:q} --output {params.prefix:q} {params.snps}
            """


rule cohort_vcf_publish:
    input:
        sv=[str(COHORT_VCF)] if MERGE_MODE != "snp" else [],
        indel=SV_SMALL_VCFS,
        snp=[str(COHORT_SNP_VCF)] if MERGE_MODE in ("all", "snp") else [],
        stage_config=MERGE_CONFIG_PATH,
        script=ancient(str(SCRIPT_DIR / "cohort_vcf_merge.py")),
    output:
        FINAL_VCFS,
    threads: 1
    resources:
        slurm_jobs=1 if SLURM_ENABLED else 0
    params:
        destination=RUN.get("merge_output_folder", str(OUT)),
        sources=shlex.join(
            (["--sv-input", str(COHORT_VCF)] if MERGE_MODE != "snp" else []) +
            (["--indel-input", SV_SMALL_VCFS[0]] if MERGE_EMIT_SMALL else []) +
            (["--snp-input", str(COHORT_SNP_VCF)] if MERGE_MODE in ("all", "snp") else [])
        ),
        slurm=slurm_prefix("merge-cohort-publish", 1, MERGE_CONCAT_MEMORY),
        cleanup=shlex.join(
            [item for path in (
                ([MERGE_TMPDIR] if MERGE_MODE != "snp" else []) +
                ([SMALL_MERGE_TMPDIR] if SMALL_VCFS else []) +
                [Path(RUN.get("merge_output_folder", str(OUT))) / "tmp" / "cohort_merge"]
            ) for item in ("--cleanup-tmpdir", str(path))]
        ) if not as_bool(RUN.get("keep_merge_tmpdir", False)) else "",
    shell:
        """
        {params.slurm} {PYTHON:q} {input.script:q} publish --{MERGE_MODE} \
          -O {params.destination:q} {params.sources} {params.cleanup}
        """


rule cohort_call_complete:
    input:
        layout=ancient(str(LAYOUT)),
        cohort_vcf=ancient(rules.cohort_vcf_publish.output),
    output:
        str(COMPLETE),
    threads: 1
    shell:
        """
        touch {output:q}
        """
