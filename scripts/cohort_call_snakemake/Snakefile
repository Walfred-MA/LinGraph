    print(
        "cohort_call_snakemake: warning: graph summary is available, but "
        f"{GRAPHCIGAR_SCRIPT} does not support --graph-summary; falling back "
        "to individual graph FASTAs. Update --script-folder to enable the "
        "consolidated-summary fast path.",
        file=sys.stderr,
    )
