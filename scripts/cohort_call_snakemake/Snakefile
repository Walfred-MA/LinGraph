configfile: "config/config.yaml"

BASE = Path(workflow.basedir).resolve()


def resolve_path(value, relative_to=BASE):
    path = Path(str(value)).expanduser()
    if not path.is_absolute():
        path = Path(relative_to) / path
    return str(path.resolve())


def as_bool(value):
    if isinstance(value, bool):
        return value
    return str(value).strip().lower() in {"1", "true", "yes", "on"}


RUN_CONFIG_PATH = resolve_path(config["run_config"])
with open(RUN_CONFIG_PATH, "rt", encoding="utf-8") as handle:
    RUN = json.load(handle)
if RUN.get("protocol") != "cohort-call-v1":
    raise ValueError("unsupported cohort calling run configuration")


def load_stage_config(run_key):
    path = resolve_path(RUN.get(run_key, RUN_CONFIG_PATH))
    with open(path, "rt", encoding="utf-8") as handle:
        return path, json.load(handle)


